#include <mach/mach.h>
#include <mach/mach_traps.h>
#include <mach/thread_switch.h>
#include <bsm/libbsm.h>
#include <fcntl.h>
#include <sys/socket.h>
#include <sys/un.h>

extern "C" {
@mach_port_get_context_declaration@
@thread_abort_declaration@
}

// Link-only SDK coverage. This executable is not run by the SDK gate.
kern_return_t explicit_context(mach_port_t reply, mach_port_name_t marker,
                               mach_port_context_t* context)
{
    return @mach_port_get_context@(reply, task_self_trap(), marker, context);
}

kern_return_t explicit_abort(mach_port_t reply, thread_act_t target)
{
    return @thread_abort@(reply, target);
}

int marker_lock(int descriptor, bool wait)
{
    struct flock request{};
    request.l_type   = F_RDLCK;
    request.l_whence = SEEK_SET;
    request.l_start  = 0;
    request.l_len    = 1;
    return fcntl(descriptor, wait ? F_OFD_SETLKW : F_OFD_SETLK, &request);
}

kern_return_t native_entry_surface(mach_port_t* marker, mach_port_t* thread)
{
    mach_port_options_t options{};
    options.flags = MPO_CONTEXT_AS_GUARD;
    constexpr mach_port_context_t context = 0x517a6039b428ed16ULL;
    *thread = mach_thread_self();
    const auto result = mach_port_construct(task_self_trap(), &options, context, marker);
    if (result != KERN_SUCCESS) return result;
    return mach_port_destruct(task_self_trap(), *marker, 0, context);
}

pid_t current_peer_pid(int endpoint)
{
    audit_token_t token{};
    socklen_t length = sizeof(token);
    if (getsockopt(endpoint, SOL_LOCAL, LOCAL_PEERTOKEN, &token, &length) != 0) return -1;
    return audit_token_to_pid(token);
}

int main()
{
    return thread_switch(MACH_PORT_NULL, SWITCH_OPTION_WAIT, 1) == KERN_SUCCESS ? 0 : 1;
}
